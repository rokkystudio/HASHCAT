# Keep patch files byte-stable. Git apply can fail if core.autocrlf turns LF patches into CRLF.
*.patch text eol=lf

# PowerShell and markdown are text files.
*.ps1 text
*.md text
*.xml text
*.txt text
# Recovery and diagnostic Android shell scripts must remain LF on Windows.
tools/*.sh text eol=lf
# Preserve raw Android console evidence, including progress carriage returns.
# Console redraw padding is intentional, not source-code trailing whitespace.
tests/fixtures/android-gpu/**/*.log -text whitespace=-blank-at-eol
