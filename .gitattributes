# Keep patch files byte-stable. Git apply can fail if core.autocrlf turns LF patches into CRLF.
*.patch text eol=lf

# PowerShell and markdown are text files.
*.ps1 text
*.md text
*.xml text
*.txt text
# Recovery and diagnostic Android shell scripts must remain LF on Windows.
tools/*.sh text eol=lf

# The source tree keeps raw source bytes stable via source/.gitattributes.
# Keep the remaining bcrypt probe and public vector LF-stable across Git checkouts.
tools/m03200-stage-probe.cl text eol=lf
tests/fixtures/android-gpu/redmagic-selected-modes-20261030/m03200.hash text eol=lf
# Preserve raw Android console evidence, including progress carriage returns.
# Console redraw padding is intentional, not source-code trailing whitespace.
tests/fixtures/android-gpu/**/*.log -text whitespace=-blank-at-eol

# Keep native Vulkan CPU test evidence LF-stable for exact log SHA-256 checks.
tests/fixtures/vulkan-host-policy-20261031/*.log text eol=lf
tests/fixtures/vulkan-host-policy-20261031/manifest.json text eol=lf

# Keep Vulkan heap allocation evidence byte-stable across Windows checkouts.
tests/fixtures/android-gpu/vulkan-heap-20261031/*.log text eol=lf
tests/fixtures/android-gpu/vulkan-heap-20261031/manifest.json text eol=lf

# Preserve Vulkan 1.0 core-baseline real device and host test log identities.
tests/fixtures/android-gpu/vulkan-core-baseline-20261031/*.log text eol=lf
tests/fixtures/android-gpu/vulkan-core-baseline-20261031/manifest.json text eol=lf

# Preserve Vulkan 1.0 three-stage synthetic GPU and native C test evidence.
tests/fixtures/android-gpu/vulkan-core-multistage-20261031/*.log text eol=lf
tests/fixtures/android-gpu/vulkan-core-multistage-20261031/manifest.json text eol=lf

# Preserve standalone Vulkan 1.0 reusable runtime GPU/fault evidence.
tests/fixtures/android-gpu/vulkan-runtime-20261031/*.log text eol=lf
tests/fixtures/android-gpu/vulkan-runtime-20261031/manifest.json text eol=lf

# Preserve original Vulkan 1.0 variable-size Compute graph GPU and C host observations.
tests/fixtures/android-gpu/vulkan-dynamic-graph-20261031/*.log text eol=lf
tests/fixtures/android-gpu/vulkan-dynamic-graph-20261031/manifest.json text eol=lf
