diff --git a/include/types.h b/include/types.h
index 3f63e0783..df6168215 100644
--- a/include/types.h
+++ b/include/types.h
@@ -32,6 +32,63 @@
 
 #include <iconv.h>
 
+#if defined (__ANDROID__) && (__ANDROID_API__ < 28)
+#include <dlfcn.h>
+#include <errno.h>
+
+static inline iconv_t hc_android_iconv_open (const char *tocode, const char *fromcode)
+{
+  typedef iconv_t (*hc_iconv_open_t) (const char *, const char *);
+
+  const hc_iconv_open_t fn = (hc_iconv_open_t) dlsym (RTLD_DEFAULT, "iconv_open");
+
+  if (fn == NULL)
+  {
+    errno = ENOSYS;
+
+    return (iconv_t) -1;
+  }
+
+  return fn (tocode, fromcode);
+}
+
+static inline size_t hc_android_iconv (iconv_t cd, char **inbuf, size_t *inbytesleft, char **outbuf, size_t *outbytesleft)
+{
+  typedef size_t (*hc_iconv_t) (iconv_t, char **, size_t *, char **, size_t *);
+
+  const hc_iconv_t fn = (hc_iconv_t) dlsym (RTLD_DEFAULT, "iconv");
+
+  if (fn == NULL)
+  {
+    errno = ENOSYS;
+
+    return (size_t) -1;
+  }
+
+  return fn (cd, inbuf, inbytesleft, outbuf, outbytesleft);
+}
+
+static inline int hc_android_iconv_close (iconv_t cd)
+{
+  typedef int (*hc_iconv_close_t) (iconv_t);
+
+  const hc_iconv_close_t fn = (hc_iconv_close_t) dlsym (RTLD_DEFAULT, "iconv_close");
+
+  if (fn == NULL)
+  {
+    errno = ENOSYS;
+
+    return -1;
+  }
+
+  return fn (cd);
+}
+
+#define iconv_open  hc_android_iconv_open
+#define iconv       hc_android_iconv
+#define iconv_close hc_android_iconv_close
+#endif
+
