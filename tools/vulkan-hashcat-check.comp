#version 450

/*
 * M2 data-path verification kernel.
 *
 * This shader is deliberately independent of any hash mode. It reads the
 * hashcat pws_buf storage buffer, computes a deterministic wrapping sum over
 * every element exactly once and writes one (sum, count) pair per workgroup
 * to the result buffer. The CPU reference in backend_vulkan_device.c uses the
 * same arithmetic, so any transfer, descriptor, dispatch-splitting or
 * readback defect changes the output.
 *
 * The program registry declares local_size_x = 1. With 131072 elements this
 * produces 131072 workgroups, which exceeds the 65535 group limit reported by
 * Adreno and forces the multi-submit path. base_group is written by the host
 * before every vkCmdDispatch chunk because a split dispatch restarts
 * gl_GlobalInvocationID at zero.
 */

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout (push_constant) uniform CheckParameters
{
  uint total_elements;
  uint stride;
  uint seed;
  uint base_group;
} parameters;

layout (set = 0, binding = 1, std430) readonly buffer PwsBuffer
{
  uint words[];
} pws;

layout (set = 0, binding = 7, std430) writeonly buffer ResultBuffer
{
  uint words[];
} result;

void main ()
{
  const uint group = parameters.base_group + gl_GlobalInvocationID.x;

  uint sum   = 0u;
  uint count = 0u;

  for (uint index = group; index < parameters.total_elements; index += parameters.stride)
  {
    const uint value = pws.words[index];

    sum += (value * 1664525u + 1013904223u) ^ (index * 2654435769u) ^ parameters.seed;

    count++;
  }

  result.words[group * 2u + 0u] = sum;
  result.words[group * 2u + 1u] = count;
}
