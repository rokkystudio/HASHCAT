#version 450

/*
 * Validate the first production-owned Vulkan 1.0 Compute pipeline on
 * public 32-bit integers. No passwords, hashes, cryptographic state or
 * HASHCAT attack inputs are accessed by this shader.
 */
layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout (set = 0, binding = 0, std430) readonly buffer InputBuffer
{
  uint words[];
} input_buffer;

layout (set = 0, binding = 1, std430) writeonly buffer OutputBuffer
{
  uint words[];
} output_buffer;

void main ()
{
  const uint index = gl_GlobalInvocationID.x;
  const uint value = input_buffer.words[index];

  output_buffer.words[index] =
    (value * 1664525u + 1013904223u) ^ (index * 2654435769u);
}
