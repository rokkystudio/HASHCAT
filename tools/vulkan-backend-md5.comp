#version 450

/*
 * Execute four independent one-block MD5 hashes using the same 32-bit round
 * operations and initial state as HASHCAT's inc_hash_md5.cl.
 *
 * Binding zero contains four fully padded 512-bit MD5 message blocks in
 * native little-endian word order. Binding one receives four 128-bit digest
 * states. The diagnostic supplies only fixed public test messages and never
 * reads HASHCAT password candidates, target digests, salts or attack state.
 */
layout (local_size_x = 4, local_size_y = 1, local_size_z = 1) in;

layout (set = 0, binding = 0, std430) readonly buffer InputBuffer
{
  uint words[];
} input_buffer;

layout (set = 0, binding = 1, std430) buffer OutputBuffer
{
  uint words[];
} output_buffer;

uint rotate_left (uint value, uint amount)
{
  return (value << amount) | (value >> (32u - amount));
}

void main ()
{
  const uint vector_index = gl_GlobalInvocationID.x;
  const uint input_base = vector_index * 16u;
  const uint output_base = vector_index * 4u;

  uint message[16];

  for (uint i = 0u; i < 16u; i++)
  {
    message[i] = input_buffer.words[input_base + i];
  }

  const uint shifts[64] = uint[64](
     7u, 12u, 17u, 22u,  7u, 12u, 17u, 22u,
     7u, 12u, 17u, 22u,  7u, 12u, 17u, 22u,
     5u,  9u, 14u, 20u,  5u,  9u, 14u, 20u,
     5u,  9u, 14u, 20u,  5u,  9u, 14u, 20u,
     4u, 11u, 16u, 23u,  4u, 11u, 16u, 23u,
     4u, 11u, 16u, 23u,  4u, 11u, 16u, 23u,
     6u, 10u, 15u, 21u,  6u, 10u, 15u, 21u,
     6u, 10u, 15u, 21u,  6u, 10u, 15u, 21u
  );

  const uint constants[64] = uint[64](
    0xd76aa478u, 0xe8c7b756u, 0x242070dbu, 0xc1bdceeeu,
    0xf57c0fafu, 0x4787c62au, 0xa8304613u, 0xfd469501u,
    0x698098d8u, 0x8b44f7afu, 0xffff5bb1u, 0x895cd7beu,
    0x6b901122u, 0xfd987193u, 0xa679438eu, 0x49b40821u,
    0xf61e2562u, 0xc040b340u, 0x265e5a51u, 0xe9b6c7aau,
    0xd62f105du, 0x02441453u, 0xd8a1e681u, 0xe7d3fbc8u,
    0x21e1cde6u, 0xc33707d6u, 0xf4d50d87u, 0x455a14edu,
    0xa9e3e905u, 0xfcefa3f8u, 0x676f02d9u, 0x8d2a4c8au,
    0xfffa3942u, 0x8771f681u, 0x6d9d6122u, 0xfde5380cu,
    0xa4beea44u, 0x4bdecfa9u, 0xf6bb4b60u, 0xbebfbc70u,
    0x289b7ec6u, 0xeaa127fau, 0xd4ef3085u, 0x04881d05u,
    0xd9d4d039u, 0xe6db99e5u, 0x1fa27cf8u, 0xc4ac5665u,
    0xf4292244u, 0x432aff97u, 0xab9423a7u, 0xfc93a039u,
    0x655b59c3u, 0x8f0ccc92u, 0xffeff47du, 0x85845dd1u,
    0x6fa87e4fu, 0xfe2ce6e0u, 0xa3014314u, 0x4e0811a1u,
    0xf7537e82u, 0xbd3af235u, 0x2ad7d2bbu, 0xeb86d391u
  );

  uint a = 0x67452301u;
  uint b = 0xefcdab89u;
  uint c = 0x98badcfeu;
  uint d = 0x10325476u;

  const uint initial_a = a;
  const uint initial_b = b;
  const uint initial_c = c;
  const uint initial_d = d;

  for (uint i = 0u; i < 64u; i++)
  {
    uint f;
    uint g;

    if (i < 16u)
    {
      f = (b & c) | ((~b) & d);
      g = i;
    }
    else if (i < 32u)
    {
      f = (d & b) | ((~d) & c);
      g = (5u * i + 1u) & 15u;
    }
    else if (i < 48u)
    {
      f = b ^ c ^ d;
      g = (3u * i + 5u) & 15u;
    }
    else
    {
      f = c ^ (b | (~d));
      g = (7u * i) & 15u;
    }

    const uint previous_d = d;

    d = c;
    c = b;
    b += rotate_left (a + f + constants[i] + message[g], shifts[i]);
    a = previous_d;
  }

  output_buffer.words[output_base + 0u] = initial_a + a;
  output_buffer.words[output_base + 1u] = initial_b + b;
  output_buffer.words[output_base + 2u] = initial_c + c;
  output_buffer.words[output_base + 3u] = initial_d + d;
}
