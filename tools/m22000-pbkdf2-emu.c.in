/*
 * CPU-only regression harness for hashcat WPA-PBKDF2 mode 22000.
 * The two helper functions below are injected verbatim from the
 * OpenCL source by tools/test-m22000-pbkdf2.py.
 * This does not execute any GPU kernel.
 */
#include "common.h"
#include "types.h"
#include "emu_inc_hash_sha1.h"

#include <stdio.h>
#include <string.h>

@@HASHCAT_HELPERS@@

static void derive_block (
  const sha1_hmac_ctx_t *base,
  const u32 ipad[5],
  const u32 opad[5],
  const u32 block,
  u32 output[5])
{
  u32 digest[5];

  m22000_init_block (base, block, digest);

  for (u32 i = 0; i < 5; i++) output[i] = digest[i];

  // The init kernel computes U1. The loop kernel computes U2..U4096.
  for (u32 iteration = 1; iteration < 4096; iteration++)
  {
    u32 w0[4] = { digest[0], digest[1], digest[2], digest[3] };
    u32 w1[4] = { digest[4], 0x80000000, 0, 0 };
    u32 w2[4] = { 0, 0, 0, 0 };
    u32 w3[4] = { 0, 0, 0, (64 + 20) * 8 };

    hmac_sha1_run_V (w0, w1, w2, w3, ipad, opad, digest);

    for (u32 i = 0; i < 5; i++) output[i] ^= digest[i];
  }
}

static void print_be_words (const char *label, const u32 *words, u32 bytes)
{
  printf ("%s=", label);

  for (u32 i = 0; i < bytes; i++)
  {
    const u32 word = words[i / 4];
    const u32 byte = (word >> (24 - 8 * (i % 4))) & 0xff;

    printf ("%02x", (unsigned int) byte);
  }

  puts ("");
}

int main (int argc, char **argv)
{
  if (argc != 3)
  {
    fprintf (stderr, "usage: test-m22000-pbkdf2 <passphrase> <ssid>\n");

    return 2;
  }

  const char *passphrase = argv[1];
  const char *ssid = argv[2];

  const size_t pass_len = strlen (passphrase);
  const size_t ssid_len = strlen (ssid);

  if (pass_len < 8 || pass_len > 63 || ssid_len > 32)
  {
    fprintf (stderr, "test vector lengths out of range\n");

    return 3;
  }

  // Global-swap helpers expect little-endian input words, as stored in
  // hashcat's candidate and ESSID buffers on a little-endian CPU.
  u32 pw_buf[16] = { 0 };
  u32 ssid_buf[16] = { 0 };

  memcpy (pw_buf, passphrase, pass_len);
  memcpy (ssid_buf, ssid, ssid_len);

  sha1_hmac_ctx_t base;

  sha1_hmac_init_global_swap (&base, pw_buf, (int) pass_len);

  u32 ipad[5];
  u32 opad[5];

  // The kernel saves these states BEFORE appending the ESSID.
  for (u32 i = 0; i < 5; i++)
  {
    ipad[i] = base.ipad.h[i];
    opad[i] = base.opad.h[i];
  }

  sha1_hmac_update_global_swap (&base, ssid_buf, (int) ssid_len);

  u32 u1[5];
  u32 u2[5];

  m22000_init_block (&base, 1, u1);
  m22000_init_block (&base, 2, u2);

  print_be_words ("U1_BLOCK1", u1, 20);
  print_be_words ("U1_BLOCK2", u2, 20);

  u32 pmk[10];

  derive_block (&base, ipad, opad, 1, pmk);
  derive_block (&base, ipad, opad, 2, pmk + 5);

  print_be_words ("PMK", pmk, 32);

  return 0;
}
