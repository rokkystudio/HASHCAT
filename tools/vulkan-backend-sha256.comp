#version 450

/*
 * Compute SHA-256 digests of independently sized byte messages.
 *
 * Binding zero contains two uint32 metadata words per message (byte offset
 * and byte length), followed by densely packed input bytes. Input uint32
 * words store successive bytes in little-endian lanes.
 *
 * Binding one contains eight uint32 SHA-256 state words per message, in
 * canonical SHA-256 word order. No message generation, digest comparison
 * or HASHCAT attack scheduling occurs in this shader.
 */
layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout (set = 0, binding = 0, std430) readonly buffer InputBuffer
{
  uint words[];
} input_data;

layout (set = 0, binding = 1, std430) writeonly buffer OutputBuffer
{
  uint words[];
} output_data;

/*
 * Read one payload byte from the little-endian input uint32 storage.
 *
 * The metadata section occupies eight bytes per message. The caller
 * supplies offsets relative to the payload beginning and exact lengths.
 */
uint read_payload_byte (uint message_count, uint byte_offset)
{
  const uint word_index = (message_count * 2u) + (byte_offset >> 2u);
  const uint word_shift = (byte_offset & 3u) * 8u;

  return (input_data.words[word_index] >> word_shift) & 0xffu;
}

/* Rotate one unsigned SHA-256 word right by a nonzero fixed amount. */
uint rotate_right (uint word, uint amount)
{
  return (word >> amount) | (word << (32u - amount));
}

/*
 * Compute the SHA-256 digest for one indexed message.
 *
 * Each invocation builds padded 512-bit blocks on demand, executes all
 * 64 SHA-256 compression rounds for every block and writes eight digest
 * words. Padding includes a 64-bit big-endian bit length assembled from
 * the caller's 32-bit byte length, so no optional GPU int64 feature is
 * required. Results depend only on the input bytes and lengths.
 */
void main ()
{
  const uint message_index = gl_GlobalInvocationID.x;
  const uint message_count = uint (output_data.words.length ()) / 8u;

  if (message_index >= message_count) return;

  const uint message_offset = input_data.words[message_index * 2u];
  const uint message_length = input_data.words[message_index * 2u + 1u];

  const uint complete_blocks = message_length / 64u;
  const uint remainder_bytes = message_length % 64u;
  const uint block_count =
    complete_blocks + (remainder_bytes < 56u ? 1u : 2u);
  const uint padded_bytes = block_count * 64u;
  const uint trailer_start = padded_bytes - 8u;
  const uint bit_length_high = message_length >> 29u;
  const uint bit_length_low = message_length << 3u;

  const uint constants[64] = uint[64](
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
    0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
    0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
    0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
    0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
    0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
    0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
    0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
  );

  uint state[8] = uint[8](
    0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au,
    0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u
  );

  for (uint block_index = 0u; block_index < block_count; block_index++)
  {
    uint schedule[64];

    for (uint i = 0u; i < 16u; i++)
    {
      uint word = 0u;

      for (uint j = 0u; j < 4u; j++)
      {
        const uint position = block_index * 64u + i * 4u + j;
        uint value = 0u;

        if (position < message_length)
        {
          value = read_payload_byte (
            message_count, message_offset + position
          );
        }
        else if (position == message_length)
        {
          value = 0x80u;
        }
        else if (position >= trailer_start)
        {
          const uint trailer_index = position - trailer_start;

          if (trailer_index < 4u)
          {
            value =
              (bit_length_high >> (24u - trailer_index * 8u)) & 0xffu;
          }
          else
          {
            value =
              (bit_length_low >> (24u - (trailer_index - 4u) * 8u))
              & 0xffu;
          }
        }

        word = (word << 8u) | value;
      }

      schedule[i] = word;
    }

    for (uint i = 16u; i < 64u; i++)
    {
      const uint x = schedule[i - 15u];
      const uint y = schedule[i - 2u];

      const uint sigma0 =
        rotate_right (x, 7u) ^ rotate_right (x, 18u) ^ (x >> 3u);
      const uint sigma1 =
        rotate_right (y, 17u) ^ rotate_right (y, 19u) ^ (y >> 10u);

      schedule[i] =
        schedule[i - 16u] + sigma0 + schedule[i - 7u] + sigma1;
    }

    uint a = state[0];
    uint b = state[1];
    uint c = state[2];
    uint d = state[3];
    uint e = state[4];
    uint f = state[5];
    uint g = state[6];
    uint h = state[7];

    for (uint i = 0u; i < 64u; i++)
    {
      const uint big_sigma1 =
        rotate_right (e, 6u) ^ rotate_right (e, 11u)
        ^ rotate_right (e, 25u);
      const uint choose = (e & f) ^ ((~e) & g);
      const uint temp1 =
        h + big_sigma1 + choose + constants[i] + schedule[i];

      const uint big_sigma0 =
        rotate_right (a, 2u) ^ rotate_right (a, 13u)
        ^ rotate_right (a, 22u);
      const uint majority = (a & b) ^ (a & c) ^ (b & c);
      const uint temp2 = big_sigma0 + majority;

      h = g;
      g = f;
      f = e;
      e = d + temp1;
      d = c;
      c = b;
      b = a;
      a = temp1 + temp2;
    }

    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
    state[5] += f;
    state[6] += g;
    state[7] += h;
  }

  const uint output_index = message_index * 8u;

  for (uint i = 0u; i < 8u; i++)
  {
    output_data.words[output_index + i] = state[i];
  }
}
